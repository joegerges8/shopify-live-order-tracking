# Server
PORT=3000
APP_URL=https://your-live-dispatch-domain.example.com

# Auth (required for driver login/signup)
JWT_SECRET=change-me-to-a-long-random-string

# Postgres (local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shopify_live_tracking
DB_USER=postgres
DB_PASSWORD=password

# Google Maps (server-side). Optional: without it the driver's route lookup
# returns 501 and the customer ETA falls back to a straight-line estimate.
GOOGLE_MAPS_SERVER_KEY=

# Customer ETA tuning (all optional — these are the defaults).
# Calibrate against real orders.delivered_at once enough deliveries have run.
# ETA_HANDLING_SECONDS=480        # per other order the driver is carrying
# ETA_LAST_MILE_SECONDS=240       # town centre -> the customer's door
# ETA_MIN_SECONDS=300             # never show less than this while undelivered
# ETA_START_WINDOW_SECONDS=600    # a GPS ping newer than this means "on the road"
# ETA_AVG_SPEED_KMH=              # pin a flat fallback speed; unset = banded by distance
# ETA_ROAD_FACTOR=1.3             # roads are longer than straight lines
# ETA_TIMEZONE=Asia/Beirut        # timezone the arrival window is shown in

# Driver performance / daily settlement (both optional — these are the defaults).
# DRIVER_FEE_PER_DELIVERY=2       # flat fee paid per completed delivery. Must match
#                                 # driverFeePerDelivery in the driver app, or the
#                                 # dispatcher and the driver read different pay.
# REPORT_TIMEZONE=Asia/Beirut     # the timezone "today's deliveries" is counted in.
#                                 # Falls back to ETA_TIMEZONE, then Asia/Beirut.

# Shopify webhook verification
SHOPIFY_CLIENT_ID=your-shopify-app-client-id
SHOPIFY_CLIENT_SECRET=your-shopify-app-client-secret
SHOPIFY_API_VERSION=2026-04
